# =====================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# IMPORTANT: DO NOT WRITE REAL PRODUCTION SECRETS OR PASSWORDS IN THIS FILE!
# Copy this file to '.env' and populate with real, secure credentials.
# =====================================================================

# Production Secret Key (Generate a random 32+ byte hex string using: `openssl rand -hex 32`)
SECRET_KEY=YOUR_SECURE_RANDOM_SECRET_KEY_HERE_MIN_32_CHARS

# Allowed CORS Origins (Comma-separated list of trusted frontend domains, or '*' for development)
CORS_ORIGINS=https://yourdomain.com,http://localhost:3000

# ---------------------------------------------------------------------
# DATABASE CONFIGURATION
# ---------------------------------------------------------------------
# PostgreSQL Connection URL format: postgresql://<user>:<password>@db:5432/<dbname>
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB

POSTGRES_USER=santex_db_user
POSTGRES_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
POSTGRES_DB=santexnika_production_db

# ---------------------------------------------------------------------
# GUNICORN WORKERS CONFIGURATION
# ---------------------------------------------------------------------
GUNICORN_WORKERS=4
