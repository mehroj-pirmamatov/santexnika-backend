# =========================================================
# Environment Variables Example for Santexnika Backend
# =========================================================

# Production Secret Key (Ushbu kalitni xavfsiz va tasodifiy string bilan almashtiring: `openssl rand -hex 32`)
SECRET_KEY=change_this_to_a_secure_random_secret_key_32_chars_min

# CORS Origins (Vergul bilan ajratilgan ruxsat berilgan domenlar ro'yxati yoki '*' for open)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# ---------------------------------------------------------
# DATABASE CONFIGURATION
# ---------------------------------------------------------
# VARIANT A: PostgreSQL (Production uchun tavsiya qilinadi)
DATABASE_URL=postgresql://santex_user:santex_secret_pass@db:5432/santexnika_db
POSTGRES_USER=santex_user
POSTGRES_PASSWORD=santex_secret_pass
POSTGRES_DB=santexnika_db

# VARIANT B: SQLite (Agar SQLite saqlab qolinadigan bo'lsa, pastdagini izohdan chiqaring)
# DATABASE_URL=sqlite:////app/data/santexnika.db

# ---------------------------------------------------------
# GUNICORN WORKERS CONFIGURATION
# ---------------------------------------------------------
GUNICORN_WORKERS=4
